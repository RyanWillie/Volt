{
  "format": "volt.linear-dc-reference-corpus",
  "version": 1,
  "conventions": {
    "voltage": "V(from)-V(to)",
    "branch_current": "positive from the authored first endpoint to the second endpoint",
    "branch_power": "(V(from)-V(to))*I; negative means delivered power",
    "comparison": "abs(actual-expected) <= absolute_tolerance + relative_tolerance*abs(expected)"
  },
  "compiled_expectations": {
    "divider": {"coverage": "complete", "branch_count": 3, "storage_count": 0, "origins": ["R1/body", "R2/body", "source:supply-5v"]},
    "series_parallel_load": {"coverage": "complete", "branch_count": 4, "storage_count": 0, "origins": ["Rseries/body", "Rload1/body", "Rload2/body", "source:drive"]},
    "source_polarity": {"coverage": "complete", "branch_count": 6, "storage_count": 0, "origins": ["Rpositive/body", "Rnegative/body", "Rcurrent/body", "source:inject", "source:negative", "source:positive"]},
    "zero_ohm_constraint": {"coverage": "complete", "branch_count": 3, "storage_count": 0, "origins": ["Rwire/body", "Rload/body", "source:drive"]},
    "ideal_capacitor_dc": {"coverage": "complete", "branch_count": 3, "storage_count": 1, "origins": ["Cstorage/storage", "Rreference/body", "source:drive"]},
    "ideal_inductor_dc": {"coverage": "complete", "branch_count": 3, "storage_count": 1, "origins": ["Lstorage/storage", "Rload/body", "source:drive"]},
    "composite_capacitor_dc": {"coverage": "complete", "branch_count": 4, "storage_count": 2, "origins": ["C1/esl", "C1/esr", "C1/storage", "source:drive"]}
  },
  "supported_cases": [
    {
      "id": "divider",
      "deck": "divider.cir",
      "analysis": "Two equal 1 kohm resistors divide an explicit 5 V source.",
      "expectations": {
        "supply_voltage_v": {"ngspice": "v(supply)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "midpoint_voltage_v": {"ngspice": "v(midpoint)", "value": 2.5, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "upper_current_a": {"ngspice": "@rupper[i]", "value": 0.0025, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "lower_current_a": {"ngspice": "@rlower[i]", "value": 0.0025, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "source_current_a": {"ngspice": "i(vdrive)", "value": -0.0025, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "resistor_power_w_each": {"derived": "2.5 V * 2.5 mA", "value": 0.00625, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "source_power_w": {"derived": "5 V * -2.5 mA", "value": -0.0125, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "power_sum_w": {"derived": "two resistor powers plus source power", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0}
      }
    },
    {
      "id": "series_parallel_load",
      "deck": "series_parallel_load.cir",
      "analysis": "A 1 kohm series resistor drives parallel 1 kohm and 2 kohm loads from 5 V.",
      "expectations": {
        "load_voltage_v": {"ngspice": "v(load)", "value": 2.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "series_current_a": {"ngspice": "@rseries[i]", "value": 0.003, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "load_1k_current_a": {"ngspice": "@rload1[i]", "value": 0.002, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "load_2k_current_a": {"ngspice": "@rload2[i]", "value": 0.001, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "source_current_a": {"ngspice": "i(vdrive)", "value": -0.003, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "load_kcl_residual_a": {"derived": "series current minus both load currents", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0}

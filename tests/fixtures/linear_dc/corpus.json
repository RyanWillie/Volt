        "current_driven_node_v": {"ngspice": "v(vi)", "value": 2.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "authored_current_source_a": {"ngspice": "@iinject[current]", "value": 0.002, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9}
      }
    },
    {
      "id": "zero_ohm_constraint",
      "deck": "zero_ohm_constraint.cir",
      "analysis": "Volt R=0 is represented independently as an ideal 0 V source; an ngspice zero-valued resistor is not used because its implementation resistance is backend-specific.",
      "expectations": {
        "supply_voltage_v": {"ngspice": "v(supply)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "load_voltage_v": {"ngspice": "v(load)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "constraint_voltage_v": {"derived": "v(supply)-v(load)", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0},
        "constraint_current_a": {"ngspice": "i(vwire)", "value": 0.005, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "source_current_a": {"ngspice": "i(vdrive)", "value": -0.005, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9}
      }
    },
    {
      "id": "ideal_capacitor_dc",
      "deck": "ideal_capacitor_dc.cir",
      "analysis": "At DC the capacitor is open: its current is zero and the downstream resistor fixes the isolated terminal to reference.",
      "expectations": {

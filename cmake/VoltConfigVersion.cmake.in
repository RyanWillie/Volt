set(PACKAGE_VERSION "@PROJECT_VERSION@")

# Volt is pre-release and does not promise compatibility between distinct versions.
# Reject ranges and every non-identical version even when the caller omits EXACT.
if(PACKAGE_FIND_VERSION_RANGE)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
elseif(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    set(PACKAGE_VERSION_EXACT TRUE)
else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
endif()

# Ignore architecture when either project has no compiled language enabled.
if("${CMAKE_SIZEOF_VOID_P}" STREQUAL "" OR "@CMAKE_SIZEOF_VOID_P@" STREQUAL "")
    return()
endif()

if(NOT CMAKE_SIZEOF_VOID_P STREQUAL "@CMAKE_SIZEOF_VOID_P@")
    math(EXPR installed_bits "@CMAKE_SIZEOF_VOID_P@ * 8")
    set(PACKAGE_VERSION "${PACKAGE_VERSION} (${installed_bits}bit)")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()

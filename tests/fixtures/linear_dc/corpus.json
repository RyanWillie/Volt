        "downstream_voltage_v": {"ngspice": "v(downstream)", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0},
        "capacitor_current_a": {"ngspice": "@cstorage[i]", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0},
        "source_current_a": {"ngspice": "i(vdrive)", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0}
      }
    },
    {
      "id": "ideal_inductor_dc",
      "deck": "ideal_inductor_dc.cir",
      "analysis": "At DC the ideal inductor imposes zero voltage while retaining its identifiable branch current.",
      "expectations": {
        "supply_voltage_v": {"ngspice": "v(supply)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "load_voltage_v": {"ngspice": "v(load)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "inductor_voltage_v": {"derived": "v(supply)-v(load)", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0},
        "inductor_current_a": {"ngspice": "@lstorage[i]", "value": 0.005, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "source_current_a": {"ngspice": "i(vdrive)", "value": -0.005, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9}
      }
    },
    {
      "id": "composite_capacitor_dc",
      "deck": "composite_capacitor_dc.cir",
      "analysis": "The C+ESR+ESL chain preserves private-node voltages and storage, but its steady-state branch current is zero.",
      "expectations": {
        "terminal_a_voltage_v": {"ngspice": "v(a)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "after_esr_voltage_v": {"ngspice": "v(after_esr)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "after_esl_voltage_v": {"ngspice": "v(after_esl)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "esr_current_a": {"ngspice": "@resr[i]", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0},
        "esl_current_a": {"ngspice": "@lesl[i]", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0},
        "capacitor_current_a": {"ngspice": "@cstorage[i]", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0},
        "source_current_a": {"ngspice": "i(vdrive)", "value": 0.0, "absolute_tolerance": 1e-12, "relative_tolerance": 0.0}
      }
    }
  ],
  "non_oracle_cases": [
    {"id": "floating_resistor_island", "volt_expectation": "rank_deficient", "oracle_status": "excluded", "reason": "A backend-selected floating gauge must not certify a unique Volt result."},
    {"id": "capacitor_only_floating", "volt_expectation": "rank_deficient", "oracle_status": "excluded", "reason": "DC-open storage leaves unfixed potentials."},
    {"id": "parallel_ideal_branches", "volt_expectation": "rank_deficient", "oracle_status": "excluded", "reason": "Individual ideal-branch currents are nonunique even when node voltages are fixed."},
    {"id": "inconsistent_source_loop", "volt_expectation": "inconsistent", "oracle_status": "excluded", "reason": "Ngspice convergence aids or a reported operating point cannot override Volt's original-law checks."},
    {"id": "unacceptable_conditioning", "volt_expectation": "unreliable", "oracle_status": "excluded", "reason": "Volt's explicit reciprocal-condition threshold is stricter than backend convergence."},
    {"id": "finite_overflow", "volt_expectation": "numerical_failure", "oracle_status": "excluded", "reason": "Non-finite assembly or reconstruction must fail rather than be normalized by an oracle."},
    {"id": "incomplete_compilation", "volt_expectation": "not_evaluated", "oracle_status": "excluded", "reason": "An incomplete S2 report has no runnable model."}
  ]
}

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Volt::IO is a static library and therefore its private Zlib link requirement remains a
# downstream link requirement. The header-only JSON dependency is build-only and does not
# appear in the installed interface.
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/VoltTargets.cmake")

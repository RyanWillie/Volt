      "id": "source_polarity",
      "deck": "source_polarity.cir",
      "analysis": "Positive and negative voltage sources plus a ground-to-node current source prove stored orientations.",
      "expectations": {
        "positive_node_v": {"ngspice": "v(vp)", "value": 5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "positive_source_current_a": {"ngspice": "i(vpositive)", "value": -0.005, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
        "negative_node_v": {"ngspice": "v(vn)", "value": -5.0, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
        "negative_source_current_a": {"ngspice": "i(vnegative)", "value": 0.005, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-9},
